{
  "uid": "go-rest-api-service-template-layers",
  "title": "go-rest-api-service-template · Layers",
  "description": "One dashboard for every layer, selected by the layer variable. Replaces the three per-layer copies of the same template -- which could not have a layer variable at all, because the layer was part of the metric name.",
  "tags": [
    "svc-qu3ry-core",
    "generated"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": "Which service's series to show. One Grafana can serve several deployments, or this service and the template it came from; without this they are summed together silently."
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total{service_name=~\"$service_name\"}, service_instance_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": "Which replica. All is the right default -- a per-replica view is for finding the odd one out."
      },
      {
        "name": "layer",
        "label": "layer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total{service_name=~\"$service_name\"}, app_layer)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": "handler (driving adapter), usecase (core), or one of the driven adapters: repository, llm, cache, mail."
      },
      {
        "name": "domain",
        "label": "domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total{app_layer=~\"$layer\",service_name=~\"$service_name\"}, app_domain)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": ""
      },
      {
        "name": "action",
        "label": "action",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(app_calls_total{app_layer=~\"$layer\",app_domain=~\"$domain\",service_name=~\"$service_name\"}, app_action)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "description": ""
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Restarts",
        "target": {
          "expr": "{service_name=~\"$service_name\"} |= `application initialization completed`",
          "refId": "Anno"
        },
        "textFormat": "restarted",
        "titleFormat": "restart"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Fatal",
        "target": {
          "expr": "{service_name=~\"$service_name\"} | severity_text=`FATAL`",
          "refId": "AnnoF"
        },
        "textFormat": "fatal",
        "titleFormat": "fatal"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🚦 $layer — golden signals",
      "collapsed": false,
