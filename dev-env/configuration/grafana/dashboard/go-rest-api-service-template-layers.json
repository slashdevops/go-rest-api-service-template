          "editorMode": "code",
          "expr": "100 * sum(rate(app_calls_total{app_layer=~\"$layer\",app_domain=~\"$domain\",app_action=~\"$action\",service_name=~\"$service_name\",service_instance_id=~\"$instance\",successful=\"false\"}[$__rate_interval])) / clamp_min(sum(rate(app_calls_total{app_layer=~\"$layer\",app_domain=~\"$domain\",app_action=~\"$action\",service_name=~\"$service_name\",service_instance_id=~\"$instance\"}[$__rate_interval])), 0.001)",
