    {
      "type": "timeseries",
      "title": "Log volume by severity",
      "description": "Records reaching Loki. TRACE never appears, at any log level: that level carries SQL arguments and LLM payloads and is stdout-only by design. A flat line means the exporter is failing, not that the service is idle -- check the telemetry panel below.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (severity_text) (count_over_time({service_name=~\"$service_name\"} [$__auto]))",
          "legendFormat": "{{severity_text}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
